---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
import "../styles/landing-hero.css";

const base = import.meta.env.BASE_URL;
const contribute = withBase("/contribute/", base);
const about = withBase("/about/", base);
const gallery = withBase("/gallery/", base);
const assignments = withBase("/assignments/", base);
const method = withBase("/method/", base);
const tokens = withBase("/design/tokens/", base);
const heroBg = withBase("/brand/hero-bg.svg", base);
const wordmark = withBase("/brand/wordmark.svg", base);
const mark = withBase("/brand/mark.svg", base);
const repoHref = "https://github.com/ruvebal/mondrian-project";
const liveHref = "https://ruvebal.github.io/mondrian-project/";
---
<BaseLayout title="Neoplastix — Mondrian Project" bare>
  <section
    class="landing"
    data-landing-hero
    data-hero-src={heroBg}
    style={`--hero-bg: url('${heroBg}')`}
  >
    <canvas class="landing__field" data-landing-field aria-hidden="true"></canvas>

    <header class="landing__chrome">
      <a class="landing__home" href={withBase("/", base)} aria-label="Neoplastix home">
        <img class="landing__mark" src={mark} width="40" height="40" alt="" />
        <span>Neoplastix</span>
      </a>
      <a
        class="landing__repo"
        href={repoHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Mondrian Project repository on GitHub"
      >
        <svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
          />
        </svg>
      </a>
    </header>

    <div class="landing__stage">
      <div class="landing__copy">
        <div
          class="favicon-canvas-25d"
          data-favicon-src={mark}
          role="img"
          aria-label="Neoplastix mark — decorative neoplastic grid"
        >
          <img src={mark} width="176" height="176" alt="" />
        </div>
        <img
          class="landing__wordmark"
          src={wordmark}
          width="420"
          height="120"
          alt="Neoplastix"
        />
        <h1 class="landing__title">Neoplastix</h1>
        <blockquote class="landing__flag">
          <p>
            La Plastique nouvelle met ses rapports en équilibre esthétique et
            exprime par là l'harmonie nouvelle.
          </p>
          <footer>
            <cite>
              <i>Le Néoplasticisme</i>. Paris: Éditions de l'Effort Moderne
              (Léonce Rosenberg), 1920.
            </cite>
          </footer>
        </blockquote>
        <p class="landing__lede">
          FE I integrator: measure neoplastic compositions, liquid-fill a free-aspect
          frame, rotate hue as study — then export a personal version. Seven seats fill
          this scaffold; the art and routes are browsable today.
        </p>
        <p class="landing__cta">
          <a class="btn btn--primary" href={assignments}>Student assignments</a>
          <a class="btn btn--ghost" href={gallery}>Gallery</a>
          <a class="btn btn--ghost" href={about}>About</a>
          <a class="btn btn--ghost" href={contribute}>Contribute</a>
        </p>
        <p class="landing__live">
          Live:
          <a href={liveHref}>{liveHref.replace(/^https:\/\//, "")}</a>
        </p>
      </div>
    </div>

    <div class="landing__footer-band">
      <div class="landing__footer-inner">
        <div>
          <h2>What this is</h2>
          <p>
            Neoplastix is the visitor product. Mondrian Project is the FE I cohort
            programme. Studies are attributed “after Mondrian” — measured SVG/Grid,
            never museum photos.
          </p>
        </div>
        <div>
          <h2>Browse the scaffold</h2>
          <ul>
            <li><a href={assignments}>Assignments by seat</a></li>
            <li><a href={method}>Method spine</a></li>
            <li><a href={tokens}>Design tokens specimen</a></li>
            <li><a href={contribute}>Contribute / lanes</a></li>
          </ul>
        </div>
        <div>
          <h2>Hard rules</h2>
          <ul>
            <li>No FastAPI from Pages</li>
            <li>No Svelte outside create/kiosk</li>
            <li>Tokens only — no raw hex in pages</li>
            <li>One measured work each (M8)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/landing-hero.js";
</script>
