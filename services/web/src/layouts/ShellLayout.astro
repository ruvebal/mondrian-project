---
import "@mondrian/tokens";
import "@mondrian/matrix/styles/matrix.css";
import "../styles/chrome.css";
import "../styles/study.css";
import FaviconLinks from "../components/FaviconLinks.astro";
import SiteNav from "../components/SiteNav.astro";

interface Props {
  title: string;
  current?: string;
  noindex?: boolean;
  lang?: string;
}

const { title, current = "", noindex = false, lang = "en" } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <FaviconLinks />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Jost:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteNav current={current} />
    <main id="main" class="shell-main">
      <slot />
    </main>
    <footer class="shell-footer">
      <p>Geometric studies after Mondrian · FE I / UDIT · Neoplastix</p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--nx-font-body);
    background: var(--nx-color-canvas);
    color: var(--nx-color-ink);
  }
  a {
    color: inherit;
  }
</style>
